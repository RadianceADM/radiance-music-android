<resources>
    <!-- Android 12 and later show their own splash first: plain black, no icon, so the app's own sunrise follows it smoothly -->
    <style name="Theme.Radiance" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/night</item>
        <item name="android:colorAccent">@color/orange</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenBackground">@color/splash</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    </style>
</resources>
